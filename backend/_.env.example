# Copia este archivo como .env (copy _.env.example .env) y completa los valores.

# --- Base de datos PostgreSQL (créala antes en pgAdmin con el nombre lookfirst) ---
# postgresql+psycopg://USUARIO:CONTRASEÑA@localhost:5432/lookfirst
DATABASE_URL=postgresql+psycopg://postgres:tu_contraseña_de_postgres@localhost:5432/lookfirst

# --- IAM ---
# Clave para firmar las sesiones. Genera una con:  py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_HORAS=10
# Primer administrador (se crea solo si la base aún no tiene ninguno)
ADMIN_NOMBRE=Administrador del salón
ADMIN_EMAIL=admin@lookfirst.pe
ADMIN_PASSWORD=cambia_esta_contraseña

# --- LLM ---
GROQ_API_KEY=gsk_coloca_aqui_tu_api_key_de_groq
GROQ_MODEL=openai/gpt-oss-20b
# Opcional: si pones GEMINI_API_KEY se usa Gemini en lugar de Groq
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- IA generativa (cambia en cada ejecución de Colab) ---
COLAB_URL=https://tu-tunel-activo.trycloudflare.com

# --- Latencia (REQ-04: <= 6 s por simulación) ---
LATENCY_BUDGET=6.0
LLM_TIMEOUT=2.5

# --- Privacidad (REQ-09): minutos máximos que una foto vive en memoria si nadie cierra la consulta ---
TTL_FOTO_MIN=30

# --- Analítica (OE4): minutos que tarda hoy un cliente en decidir con el método tradicional ---
# Mídelo en el salón piloto y ponlo aquí para que el panel calcule la reducción (meta -40 %).
TIEMPO_DECISION_TRADICIONAL_MIN=0

# --- Frontend permitido (CORS) ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
